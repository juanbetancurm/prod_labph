# Copy this file to .env.production on the VPS. Never commit .env.production.

POSTGRES_DB=physics_lab
POSTGRES_USER=physics_lab
POSTGRES_PASSWORD=replace_with_a_long_url_safe_random_password

# Keep the password in this URL identical to POSTGRES_PASSWORD.
# Use a URL-safe password so it does not require percent encoding here.
DATABASE_URL=postgresql://physics_lab:replace_with_a_long_url_safe_random_password@db:5432/physics_lab?schema=public

FRONTEND_ORIGIN=https://physicslab.labolavs.com
SESSION_COOKIE_NAME=physics_lab_session
SESSION_TTL_HOURS=12

# Optional. By default Docker builds and uses physics-lab-app:local.
# PHYSICS_LAB_IMAGE=ghcr.io/your-github-user/physics-lab:latest

# Used only when the production database is seeded manually for the first time.
SEED_TEACHER_EMAIL=teacher@example.com
SEED_TEACHER_PASSWORD=replace_with_a_different_strong_password
SEED_TEACHER_NAME=Physics Lab Teacher
