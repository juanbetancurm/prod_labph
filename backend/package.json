{
  "name": "@physics-lab/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.js",
    "verify:data": "node scripts/verify-seed-source.js",
    "check": "node --check src/server.js && node --check prisma/seed.js && node --check scripts/verify-seed-source.js"
  },
  "dependencies": {
    "@prisma/client": "^6.11.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "multer": "^2.0.1"
  },
  "devDependencies": {
    "prisma": "^6.11.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
